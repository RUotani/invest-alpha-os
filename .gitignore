.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

.venv/
venv/

# Local runtime data (never commit) — root only (do not ignore src/invis_alpha_os/data/)
/data/

# Secrets / env
.env
.env.*
!.env.example
*.env
credentials.json
token.json
secrets/
credentials/
keys/
*.key
*.pem

# Editor
.vscode/
.idea/

outputs/**
!outputs/**/
!outputs/**/.gitkeep
# Ops runner output — always local-only (overrides !**/.gitkeep above)
outputs/ops/
# J-Quants smoke summaries: JSON is local-only; .gitkeep keeps the directory in repo
outputs/jquants_smoke/*.json
!outputs/jquants_smoke/.gitkeep
.ai/reviews/*.md
.ai/reviews/*.json

# Local ops smoke artifacts (generated; do not commit)
.agent/ops_smoke/

# Generated reports and local runtime outputs (archive in reports-private)
/reports/
!/reports/**/sample_weekly_observation_report_v1.md

# Local broker/manual data inputs
manual_jp_bars.csv
manual_jp_bars.tsv
manual_jp_bars.txt
manual_jp_bars.xlsx
broker_jp_bars.*
moomoo_jp_bars.*
sbi_jp_bars.*
rakuten_jp_bars.*

# Email previews
*.eml
email_preview.*

