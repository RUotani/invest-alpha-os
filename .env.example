# Never commit real secrets. Copy to .env for local use.
# Phase 0 does not require any API keys.

# Example placeholders (leave empty)
EDINET_API_KEY=
SEC_API_KEY=

# J-Quants (Phase 1a)
# Do not put real emails, passwords, or tokens in this file.
# After reading the official J-Quants docs (Version2), fill JQUANTS_API_BASE_URL in your local .env only.
JQUANTS_API_VERSION=v2
# Base URL for your API version (often includes a version segment in the path). Leave empty until verified.
JQUANTS_API_BASE_URL=
JQUANTS_ENABLED=false
JQUANTS_ALLOW_LIVE_HTTP=false
JQUANTS_EMAIL=
JQUANTS_PASSWORD=
JQUANTS_REFRESH_TOKEN=
JQUANTS_ID_TOKEN=
