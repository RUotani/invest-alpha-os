# Never commit real secrets. Copy to .env for local use.
# Phase 0 does not require any API keys.

# Example placeholders (leave empty)
EDINET_API_KEY=
SEC_API_KEY=

# J-Quants — Version 2 (primary)
# Do not put real API keys, emails, passwords, or tokens in this file.
# After reading the official J-Quants V2 docs, set base URL and API key in your local .env only.
JQUANTS_API_VERSION=v2
JQUANTS_API_BASE_URL=
JQUANTS_API_KEY=
JQUANTS_ENABLED=false
JQUANTS_ALLOW_LIVE_HTTP=false

# Optional: your J-Quants plan’s data subscription window (YYYY-MM-DD or YYYYMMDD).
# When both are set, CLI blocks --date / --from-date / --to-date outside this range before HTTP.
# IMPORTANT: Copy into your local .env and set these to match YOUR contract (dashboard / API message).
# Repository values below are an example only (human-maintained; Task 9.2 illustrative window).
JQUANTS_DATA_AVAILABLE_FROM=2024-02-18
JQUANTS_DATA_AVAILABLE_TO=2026-02-17

# J-Quants — Version 1 legacy (refresh / id token flows; not used when JQUANTS_API_VERSION=v2)
JQUANTS_EMAIL=
JQUANTS_PASSWORD=
JQUANTS_REFRESH_TOKEN=
JQUANTS_ID_TOKEN=
